#!/usr/bin/env bash
# One update cycle: discover → compare → verify → preflight → canary →
# validate → swap → post-swap gate → rollback on failure.
#
# Exit 0 = up to date, or updated and verified.
# Exit 1 = a human is needed (no Healthchecks success ping).
# Exit 2 = deliberately skipped (quarantine, a refused major bump, or a
# concurrent cycle already holding the lock).
set -euo pipefail

LIB=/usr/local/lib/unbound-autoupdate
# shellcheck source=updater/lib/log.sh
. "$LIB/log.sh"
# shellcheck source=updater/lib/state.sh
. "$LIB/state.sh"
# shellcheck source=updater/lib/discover.sh
. "$LIB/discover.sh"
# shellcheck source=updater/lib/validate.sh
. "$LIB/validate.sh"
# shellcheck source=updater/lib/canary.sh
. "$LIB/canary.sh"
# shellcheck source=updater/lib/verify.sh
. "$LIB/verify.sh"
# shellcheck source=updater/lib/metrics.sh
. "$LIB/metrics.sh"
# shellcheck source=updater/lib/selfupdate.sh
. "$LIB/selfupdate.sh"
# shellcheck source=updater/lib/cache.sh
. "$LIB/cache.sh"

WATCH_CONFIG="${WATCH_CONFIG:-1}"
ALLOW_MAJOR="${ALLOW_MAJOR:-0}"
CHECK_ONLY="${CHECK_ONLY:-0}"

state_init
exec 9>"$LOCK_FILE"
# A concurrent cycle already holding the lock is a deliberate skip, not
# "nothing to do" — it gets the same exit code as quarantine/major-bump.
flock -n 9 || { log_info "another cycle is already running"; exit 2; }

CYCLE_START=$(date -u +%s)
FINISHED=0
CANARY_ACTIVE=0
CACHE_DUMP=""

# finish <status> <code> — the ONLY way out of a cycle once the lock is held:
# persists the outcome and its counter, rewrites metrics.prom, exits.
finish() {
  FINISHED=1
  record_cycle "$1" $(( $(date -u +%s) - CYCLE_START ))
  exit "$2"
}

# One EXIT trap for the whole cycle. It tears down a live canary and, when
# the script died on its own (log_die, set -e) rather than through finish,
# records the cycle as an error so the staleness and failure alerts fire
# instead of the previous status lingering as if nothing had happened.
_on_exit() {
  local rc=$?
  [ "$CANARY_ACTIVE" = 1 ] && canary_down
  [ -n "$CACHE_DUMP" ] && rm -f "$CACHE_DUMP"
  if [ "$FINISHED" = 0 ]; then
    record_cycle error $(( $(date -u +%s) - CYCLE_START )) || true
  fi
  exit "$rc"
}
trap _on_exit EXIT

# SIGTERM (`docker stop`, `docker compose down`, forwarded by the loop): end
# the cycle now — the EXIT trap tears down a canary and records the cycle —
# EXCEPT inside the swap/rollback section, where stopping half-way would leave
# production between two images. There the signal is noted and the section
# runs on; if the container is killed before it ends, the swap intent
# persisted in state.env makes the next cycle finish the job
# (recover_interrupted_swap).
IN_SWAP=0
TERM_PENDING=0
_on_term() {
  if [ "$IN_SWAP" = 1 ]; then
    TERM_PENDING=1
    log_warn "SIGTERM received during the swap — finishing it before stopping"
  else
    log_warn "SIGTERM received — ending the cycle"
    exit 143
  fi
}
trap _on_term TERM

hc_start
# The resolver may be mid-recreation when this cycle starts (a configuration
# change applied by hand or by a configuration-management run does exactly
# that). Wait for it rather than record a failed update. After an interrupted
# swap the resolver may exist but not run at all (killed inside `compose up`):
# discovery then also accepts a stopped container, and the recovery below
# brings DNS back instead of waiting for a container nobody will start.
: "${DISCOVER_WAIT:=60}"
export DISCOVER_WAIT
SWAP_INTENT=$(state_get SWAP_INTENT)
if [ -n "$SWAP_INTENT" ]; then DISCOVER_ALL=1; export DISCOVER_ALL; fi
discover_target

# Everything about "what runs" comes from the running CONTAINER: its image ID
# (lib/discover.sh, "Image identity"). RUNNING is only its human-readable name.
PRE_SWAP_CONTAINER="$TARGET_CONTAINER"
RUNNING_ID=$(docker inspect "$TARGET_CONTAINER" --format '{{.Image}}')
RUNNING_REPO=$(familiar_repo "$(_image_repo "$(docker inspect "$TARGET_CONTAINER" --format '{{.Config.Image}}')")")
RUNNING=$(describe_image "$RUNNING_ID" "$(_image_repo "$DECLARED_IMAGE_REF")")
RUNNING_VERSION=$(container_version "$TARGET_CONTAINER")
RUNNING_KEEP=$(keep_name "$RUNNING_REPO" "$COMPOSE_PROJECT" "$TARGET_SERVICE")
SELF_KEEP=$(keep_name "$(familiar_repo "$(_image_repo "$SELF_IMAGE")")" "$COMPOSE_PROJECT" "$(_label "$SELF_ID" com.docker.compose.service)")
# What the operator's declared tag named before this cycle's swap (empty when
# it named nothing): put back when a rollback has to go through a pin file.
PRE_TAG_ID=""

# ── Rollback (also used by the recovery of an interrupted swap) ─────────────
# rollback_and_finish <quarantine:0|1> — put production back on RUNNING_ID and
# end the cycle. Globals: RUNNING_ID, RUNNING, RUNNING_REPO, DECLARED,
# DECLARED_IMAGE_REF, SWAPPED_CONTAINER, image_changed, conf_changed, CONF_HASH.
#
# The operator's tag is moved back onto the previous image (its record kept
# alive by keep_running, so no registry is needed) and the service recreated
# with --force-recreate and --pull never: on a config-only cycle the image is
# the SAME, and without --force-recreate Compose would keep the failed
# container and the rollback would report a recovery that never happened.
# Only when the operator's file declares a digest — or another repository —
# can no tag express the previous image; then an override pins the
# sidecar-owned keep name (keep_name), and the declared tag, if the swap moved
# it, is put back where it was. A later plain `docker compose up -d` then
# deploys what the file declares: that cannot be a no-op, since the file
# itself names an image other than the one restored.
rollback_and_finish() {
  local quarantine="$1" rb_by_tag rollback_ok=1 rollback_out="" rollback_replaced=0 probe config_note=""
  IN_SWAP=1
  log_error "post-swap validation failed — rolling back to $RUNNING"
  case "$DECLARED_IMAGE_REF" in
    *@*) rb_by_tag=0 ;;
    *) if [ "$(_image_repo "$DECLARED_IMAGE_REF")" = "$RUNNING_REPO" ]; then rb_by_tag=1; else rb_by_tag=0; fi ;;
  esac
  if [ -z "$(image_id_of "$RUNNING_ID")" ]; then
    rollback_ok=0; rollback_out="the previous image $RUNNING_ID has no local record"
  elif [ "$rb_by_tag" = 1 ]; then
    if tag_for_deploy "$DECLARED_IMAGE_REF" "$RUNNING_ID"; then
      rollback_out=$(compose up -d --no-deps --pull never --force-recreate "$TARGET_SERVICE" 2>&1) || rollback_ok=0
    else
      rollback_ok=0; rollback_out="cannot move $DECLARED_IMAGE_REF back to $RUNNING_ID"
    fi
  else
    COMPOSE_EXTRA_FILE="$ROLLBACK_FILE"
    if keep_running "$RUNNING_KEEP" "$RUNNING_ID" \
       && write_pin_file "$COMPOSE_EXTRA_FILE" "$RUNNING_KEEP" "$TARGET_SERVICE"; then
      rollback_out=$(compose up -d --no-deps --pull never --force-recreate "$TARGET_SERVICE" 2>&1) || rollback_ok=0
    else
      rollback_ok=0; rollback_out="no local name for the previous image"
    fi
    unset COMPOSE_EXTRA_FILE
    case "$DECLARED_IMAGE_REF" in
      *@*) : ;;
      *) if [ -n "$PRE_TAG_ID" ]; then docker tag "$PRE_TAG_ID" "$DECLARED_IMAGE_REF" >/dev/null 2>&1 || true
         else docker image rm "$DECLARED_IMAGE_REF" >/dev/null 2>&1 || true; fi ;;
    esac
  fi
  # A `compose up` that recreated but did not start (left in `created`, e.g.
  # after an interrupted recreate) is started once more before being judged.
  local c
  c=$(_service_container "$TARGET_SERVICE" -a)
  if [ -n "$c" ] && [ "$(docker inspect "$c" --format '{{.State.Status}}' 2>/dev/null)" = created ]; then
    log_warn "rollback: the recreated resolver was left created, not running — starting it"
    docker start "$c" >/dev/null 2>&1 || compose up -d --no-deps --pull never "$TARGET_SERVICE" >/dev/null 2>&1 || true
  fi
  if [ "$rollback_ok" = 0 ]; then
    log_error "docker compose up failed while rolling back to $RUNNING"
    printf '%s\n' "$rollback_out" >&2
  fi
  TARGET_CONTAINER=$(compose ps -q "$TARGET_SERVICE" || true)
  # What the rollback must be SEEN to have done before it may call itself one:
  # a new container (never the one that just failed) running the previous image.
  if [ -n "$TARGET_CONTAINER" ] && [ "$TARGET_CONTAINER" != "${SWAPPED_CONTAINER:-}" ] \
     && [ "$(docker inspect "$TARGET_CONTAINER" --format '{{.Image}}' 2>/dev/null)" = "$RUNNING_ID" ]; then
    rollback_replaced=1
  elif [ "$rollback_ok" = 1 ]; then
    log_error "rollback: the failed container was not replaced by one running $RUNNING"
  fi

  # Quarantine every axis that actually changed for this cycle — independently,
  # not either/or: when both the image and the configuration changed together
  # and the deployment failed, either one could be the culprit (or both), and
  # quarantining only one leaves the cycle free to retry — and re-break DNS —
  # on the other the moment its own window lapses or its tag moves again. An
  # axis that did NOT change is never quarantined. An interrupted swap whose
  # new container never got to be judged quarantines nothing (quarantine=0).
  if [ "$quarantine" = 1 ]; then
    [ "$image_changed" = 1 ] && quarantine_set "$DECLARED"
    [ "$conf_changed" = 1 ] && config_quarantine_set "$CONF_HASH"
  fi

  # The rollback restores only the image — it cannot revert a bind-mounted
  # configuration file's CONTENTS. Whenever the configuration changed,
  # "restored" would be a lie without saying so.
  if [ "$conf_changed" = 1 ]; then
    config_note=" NOTE: the bind-mounted configuration file was NOT reverted — only the image was put back. Production is recreated on the previous image but is still reading the CURRENT configuration on disk. A human must fix or revert that file."
  fi

  if [ "$rollback_ok" = 1 ] && [ "$rollback_replaced" = 1 ] \
     && probe=$(target_probe_ip) && wait_resolver "$probe" 45 && validate_resolver "$probe"; then
    state_set SWAP_INTENT ""
    IN_SWAP=0
    keep_running "$RUNNING_KEEP" "$RUNNING_ID" || true
    prune_pulled "$DECLARED"
    if [ "$conf_changed" = 1 ]; then
      log_info "rollback successful — production restored on $RUNNING (configuration NOT reverted)"
    else
      log_info "rollback successful — production restored on $RUNNING"
    fi
    [ -n "$CACHE_DUMP" ] && cache_restore "$TARGET_CONTAINER" "$CACHE_DUMP"
    notify rollback "ROLLBACK performed" "The swap to $DECLARED failed its post-swap validation. Production was rolled back to $RUNNING and is healthy.${config_note}

WARNING: the compose file still declares the failing image. The local tag was put back on the previous image, so a plain 'docker compose up -d' keeps it; a 'docker compose pull' (or pull_policy: always) followed by 'docker compose up -d' would redeploy the failing image. The updater will not retry before RETRY_AFTER=${RETRY_AFTER:-24h}."
    hc_fail "post-swap validation failed"
    finish rollback 1
  fi
  # The intent stays recorded so that the next cycle tries the rollback once
  # more — but only once: a recovery that fails too abandons it, or a host
  # whose previous image is gone would page "critical" every cycle until a
  # human edited state.env. Discovery and the alerts then take over.
  if [ "${RECOVERING:-0}" = 1 ]; then
    state_set SWAP_INTENT ""
    log_error "the interrupted swap could not be finished or rolled back — abandoned; the next cycles treat the resolver as they find it"
  fi
  IN_SWAP=0
  log_error "rollback did NOT restore a healthy resolver — MANUAL INTERVENTION REQUIRED"
  notify critical "CRITICAL: rollback failed" "The swap to $DECLARED failed AND the rollback to $RUNNING did not restore a working resolver. DNS is likely down on this host.${config_note} MANUAL INTERVENTION REQUIRED."
  hc_fail "post-swap validation failed"
  finish critical 1
}

# post_swap_validated — the post-swap verdict, in a function of its own. (The
# test suite's derived image inserts its forced-failure hook at the top of
# this function; the shipped script reads no test variable at all.)
#
# Every check below can fail (a service that never reappears, a probe
# address that cannot be determined) and must fall through to rollback
# rather than abort the whole script. Folding them into ONE condition, called
# from an `if`, is what makes that safe: bash's `set -e` never fires inside a
# command that is part of an if/while/until condition, so a bare assignment
# whose command substitution dies internally (target_probe_ip calls log_die)
# just makes this false instead of exiting mid-way with no rollback and no
# notification.
#
# The image check is load-bearing on the IMAGE path: Compose returning 0 is
# not proof the swap happened. The container must run DEPLOY_ID itself — the
# verified, canaried image — whatever the tag or the registry say by now. On
# a CONFIG-ONLY cycle the image comparison is a tautology; the container-id
# comparison closes that: a genuine recreation always yields a new container.
#
# 45s here, not the canary's 90s: production restarts warm on an existing
# volume, the canary cold on a cloned one. A spurious rollback is itself safe.
post_swap_validated() {
  TARGET_CONTAINER=$(compose ps -q "$TARGET_SERVICE") && [ -n "$TARGET_CONTAINER" ] \
    && [ "$TARGET_CONTAINER" != "$PRE_SWAP_CONTAINER" ] \
    && [ "$(docker inspect "$TARGET_CONTAINER" --format '{{.Image}}')" = "$DEPLOY_ID" ] \
    && probe=$(target_probe_ip) \
    && wait_resolver "$probe" 45 && validate_resolver "$probe"
}

# record_success_and_finish — production runs DECLARED (DEPLOY_ID), validated.
record_success_and_finish() {
  local version note="${1:-}"
  state_set SWAP_INTENT ""
  IN_SWAP=0
  state_set LAST_IMAGE_DIGEST "$DECLARED"
  state_set LAST_CONFIG_HASH "$CONF_HASH"
  quarantine_clear
  config_quarantine_clear
  keep_running "$(keep_name "$(familiar_repo "$(_image_repo "$DECLARED")")" "$COMPOSE_PROJECT" "$TARGET_SERVICE")" "$DEPLOY_ID" || true
  prune_pulled "$DECLARED"
  version=$(image_version_label "$DEPLOY_ID")
  log_info "production updated and verified: $DECLARED (unbound ${version:-unknown})"
  [ -n "$CACHE_DUMP" ] && cache_restore "$TARGET_CONTAINER" "$CACHE_DUMP"
  notify updated "updated successfully" "Project $COMPOSE_PROJECT, service $TARGET_SERVICE now runs $DECLARED (unbound ${version:-unknown}) and passed every post-deployment check.${note}${CACHE_NOTE}"
  # Stopping: production is consistent now; no self-update on the way out.
  if [ "$TERM_PENDING" = 1 ]; then hc_success; finish updated 0; fi
  if self_update; then hc_success; finish updated 0; fi
  hc_fail "sidecar self-update refused"
  finish blocked 1
}

# ── Recovery of an interrupted swap ─────────────────────────────────────────
# A swap persists its intent (SWAP_INTENT) before `compose up` and clears it
# once production is validated or rolled back. Finding it set means the
# previous cycle was killed in between — `docker stop` running out of grace
# time, a host reboot, an OOM kill. Accepting what runs without judging it
# would let an unvalidated image stand forever ("up to date"); waiting for a
# resolver nobody will start would leave DNS down. So: if the declared image
# is running, judge it exactly as the post-swap gate would; otherwise, or if
# it fails, roll back to the image recorded as running before the swap.
if [ -n "$SWAP_INTENT" ]; then
  read -r i_declared i_deploy i_running i_conf i_imgch i_confch i_repo i_pre i_pretag <<<"$SWAP_INTENT"
  i_now=$(docker inspect "$TARGET_CONTAINER" --format '{{.Image}}' 2>/dev/null || true)
  i_state=$(docker inspect "$TARGET_CONTAINER" --format '{{.State.Status}}' 2>/dev/null || true)
  if [ "$i_state" = running ] && [ "$i_now" != "$i_deploy" ] && [ "$i_now" != "$i_running" ]; then
    # Contradicted: the resolver runs neither image of the swap — someone
    # deployed by hand while the sidecar was down. Rolling back over that
    # would undo a human's decision; the intent is simply dropped and this
    # cycle judges what runs, like any other.
    log_warn "the swap intent to $i_declared is contradicted by what runs ($i_now) — dropped"
    state_set SWAP_INTENT ""
  elif [ "$i_state" = running ] && [ "$i_now" = "$i_running" ] \
       && { [ "$i_now" != "$i_deploy" ] || [ "$TARGET_CONTAINER" = "${i_pre:-}" ]; }; then
    # The swap never got as far as replacing the old resolver, which still
    # serves — still the old image, or (configuration-only swap, same image)
    # still the very container recorded before the swap: nothing to judge or
    # roll back, and certainly nothing to record as "updated". Leftovers of the interrupted
    # recreate are cleared and this cycle simply tries again.
    log_warn "the swap to $i_declared was interrupted before production changed — clearing it"
    for c in $(docker ps -aq --filter "label=com.docker.compose.project=$COMPOSE_PROJECT" \
                 --filter "label=com.docker.compose.service=$TARGET_SERVICE" \
                 --filter status=created --filter status=exited --filter status=dead 2>/dev/null); do
      docker rm -f "$c" >/dev/null 2>&1 || true
    done
    state_set SWAP_INTENT ""
  else
    DECLARED="$i_declared"; DEPLOY_ID="$i_deploy"; RUNNING_ID="$i_running"; CONF_HASH="$i_conf"
    image_changed="$i_imgch"; conf_changed="$i_confch"; RUNNING_REPO="$i_repo"
    PRE_TAG_ID="${i_pretag:-}"; [ "$PRE_TAG_ID" = - ] && PRE_TAG_ID=""
    RUNNING=$(describe_image "$RUNNING_ID" "$RUNNING_REPO")
    RUNNING_KEEP=$(keep_name "$RUNNING_REPO" "$COMPOSE_PROJECT" "$TARGET_SERVICE")
    SWAPPED_CONTAINER="$TARGET_CONTAINER"
    RECOVERING=1
    log_warn "the previous cycle was interrupted during the swap to $DECLARED — finishing it"
    if [ "$i_state" = running ] && [ "$i_now" = "$DEPLOY_ID" ]; then
      # Judged exactly as the post-swap gate would — including "a NEW
      # container": the one recorded before the swap must not pass for it.
      PRE_SWAP_CONTAINER="${i_pre:-}"
      IN_SWAP=1
      if post_swap_validated; then
        record_success_and_finish " (The swap was completed after an interrupted cycle.)"
      fi
      rollback_and_finish 1
    fi
    # Not running the new image: an interrupted recreate. Compose v5 may have
    # left the old container Exited and the new one Created under a temporary
    # name; neither is started by a restart policy, and a `compose up` over
    # that state can itself stop at Created. Clear every non-running container
    # of the service first, then roll back.
    for c in $(docker ps -aq --filter "label=com.docker.compose.project=$COMPOSE_PROJECT" \
                 --filter "label=com.docker.compose.service=$TARGET_SERVICE" \
                 --filter status=created --filter status=exited --filter status=dead 2>/dev/null); do
      docker rm -f "$c" >/dev/null 2>&1 || true
    done
    rollback_and_finish 0
  fi
fi

# Keep the running images' records alive whatever happens to the tags, and
# never let prune_pulled touch them.
keep_running "$RUNNING_KEEP" "$RUNNING_ID" || true
keep_running "$SELF_KEEP" "$SELF_IMAGE_ID" || true
PRUNE_PROTECT_IDS="$RUNNING_ID $SELF_IMAGE_ID"

# What the declared tag names in the registry NOW, pulled by digest: no local
# tag moves (lib/discover.sh, "Image identity"). A pinned digest is used as is.
if ! DECLARED=$(resolve_registry_digest "$DECLARED_IMAGE_REF") || ! pull_by_digest "$DECLARED"; then
  log_error "pulling the declared image failed"
  hc_fail "pull failed"
  finish blocked 1
fi
DEPLOY_ID=$(image_id_of "$DECLARED")
PRUNE_PROTECT_IDS="$PRUNE_PROTECT_IDS $DEPLOY_ID"
# An explicit failure path rather than letting `set -e` kill the script: a
# fingerprint that cannot be computed must still reach Healthchecks as a
# failed cycle, not as a start ping that never completes.
if ! CONF_HASH=$(config_fingerprint); then
  log_error "cannot fingerprint the declared configuration"
  hc_fail "config fingerprint failed"
  finish blocked 1
fi
LAST_CONF=$(state_get LAST_CONFIG_HASH)

image_changed=0; conf_changed=0
[ "$DEPLOY_ID" != "$RUNNING_ID" ] && image_changed=1
if [ "$WATCH_CONFIG" = 1 ] && [ -n "$LAST_CONF" ] && [ "$CONF_HASH" != "$LAST_CONF" ]; then
  conf_changed=1
fi

# First ever run: record the baseline instead of canarying a system that is
# already running fine. `check` mode is there for validating on demand.
# conf_changed above was already computed against the PRIOR (empty) LAST_CONF,
# so this baseline write cannot itself manufacture a spurious conf_changed=1.
if [ -z "$LAST_CONF" ]; then
  state_set LAST_CONFIG_HASH "$CONF_HASH"
  # LAST_IMAGE_DIGEST is an operator-facing breadcrumb in state.env (handy
  # for a human inspecting it by hand) — no code path reads it back as a
  # control input.
  state_set LAST_IMAGE_DIGEST "$RUNNING"
  log_info "baseline recorded (image $RUNNING)"
  notify baseline "baseline recorded" "The updater is now watching $TARGET_SERVICE in project $COMPOSE_PROJECT."
fi

# refuse_unverified — the verdict for an image this sidecar could not verify.
# Production is never touched by it, and no tag moved. When the image is the
# one ALREADY running (first cycle on a host, or a configuration-only
# change), stopping or replacing it would not undo whatever it has already
# done, and would turn a supply-chain alarm into a DNS outage. So the resolver
# keeps serving, nothing is canaried or recreated on that image, and every
# cycle fails until a human looks. VERIFY_FAILURE (lib/verify.sh) tells a
# signature that was checked and refused from one that could not be checked
# at all (registry or transparency log unreachable): the second is not a
# supply-chain incident and says so — but it is never deployable either.
#
# Self-update is still attempted on this path (it verifies the sidecar image
# on its own, against the sidecar's identity): a FALSE refusal — a mistake in
# the expected identity, a trust-root or cosign incompatibility, a release
# that failed to sign — would otherwise strand every host on the very sidecar
# that cannot receive the fix. The cycle still ends `blocked`.
refuse_unverified() {
  local what
  if [ "$image_changed" = 1 ]; then what="Image $DECLARED"; else what="Image $DECLARED, which production is already running,"; fi
  if [ "${VERIFY_FAILURE:-refused}" = unavailable ]; then
    log_error "cosign could not check the signature of $DECLARED (registry or transparency log unreachable) — nothing deployed"
    notify blocked "signature could not be checked" "$what could not be verified: the registry or the transparency log did not answer. Nothing was deployed or recreated; production keeps serving. This is not a refused signature; the next cycle tries again."
    self_update || log_error "self-update refused as well (see above)"
    hc_fail "signature check unavailable"
    finish blocked 1
  fi
  if [ "$image_changed" = 1 ]; then
    log_error "cosign verification FAILED for $DECLARED — refusing to deploy"
    notify blocked "signature verification FAILED" "Image $DECLARED is not signed by the expected release pipeline. Deployment refused; production untouched. Investigate immediately."
  else
    log_error "cosign verification FAILED for the RUNNING image $DECLARED — it keeps serving, but nothing will be canaried or recreated on it"
    notify blocked "signature verification FAILED" "Image $DECLARED, which production is already running, is not signed by the expected release pipeline. Production is left serving on it — stopping it would not undo what it already did — but no canary, recreation or configuration change will be applied on this image. Investigate immediately."
  fi
  self_update || log_error "self-update refused as well (see above)"
  hc_fail "signature verification failed"
  finish blocked 1
}

if [ "$image_changed" = 0 ] && [ "$conf_changed" = 0 ] && [ "$CHECK_ONLY" != 1 ]; then
  # Nothing to deploy — but the image in service may never have been checked
  # by this sidecar (the one it found at baseline). DECLARED is that very
  # image (same ID). Once per digest and policy.
  verify_image_once "$DECLARED" resolver || refuse_unverified
  prune_pulled "$DECLARED"
  log_info "up to date ($RUNNING)"
  if self_update; then hc_success; finish up_to_date 0; fi
  hc_fail "sidecar self-update refused"
  finish blocked 1
fi

if [ "$image_changed" = 1 ] && quarantine_active "$DECLARED"; then
  log_warn "image $DECLARED is quarantined after a failed deployment — not retrying yet"
  notify skipped "update skipped (quarantine)" "Image $DECLARED previously failed its post-swap validation and was rolled back. It will not be retried before RETRY_AFTER=${RETRY_AFTER:-24h} elapses, or until a different image is published."
  hc_fail "quarantined image"
  finish skipped 2
fi

# Same mechanism, keyed on the configuration fingerprint instead of the image
# digest: a config-only failure has no image worth quarantining (the image
# never changed and is still good), so without this axis the cycle would
# either quarantine the wrong thing or retry — and break DNS — every hour.
# Checked independently of image_changed (NOT only when the image is
# unchanged): a mixed image+config failure quarantines BOTH axes on the way
# out, and this fingerprint match is what makes that write side mean
# something — otherwise, the moment the image's own quarantine window lapses
# or a new digest is published, the cycle would retry with the SAME still-
# broken configuration and re-break DNS. A different (edited) configuration
# always gets a fresh attempt regardless of what the image is doing, exactly
# as a different image digest does on its own axis.
if [ "$conf_changed" = 1 ] && config_quarantine_active "$CONF_HASH"; then
  log_warn "configuration $CONF_HASH is quarantined after a failed deployment — not retrying yet"
  notify skipped "update skipped (quarantine)" "The current configuration (fingerprint $CONF_HASH) previously failed its post-swap validation and was rolled back; the image is unaffected and unchanged. It will not be retried before RETRY_AFTER=${RETRY_AFTER:-24h} elapses, or until the configuration is edited again."
  hc_fail "quarantined configuration"
  finish skipped 2
fi

if [ "$image_changed" = 1 ]; then
  # Verified BEFORE its version label is read: the label of an unsigned image
  # is whatever its author wrote. An unsigned image labelled with the next
  # major version used to end the cycle as "major bump not deployed" — a
  # routine, expected-looking outcome — for as long as it stayed behind the
  # tag, and the missing signature was never reported. (The verdict is
  # remembered, so the verification further down is not a second round trip.)
  verify_image_once "$DECLARED" resolver || refuse_unverified
  # The running version comes from the running CONTAINER's labels: the image
  # record of what runs may have no name left to be inspected by.
  old_v="$RUNNING_VERSION"; new_v=$(image_version_label "$DECLARED")
  if major_bump "$old_v" "$new_v" && [ "$ALLOW_MAJOR" != 1 ]; then
    log_warn "$MAJOR_REASON — refused (set ALLOW_MAJOR=1 to accept)"
    notify skipped "major version bump not deployed" "The declared image moves Unbound from $old_v to $new_v ($MAJOR_REASON). Major bumps are a deliberate human decision; set ALLOW_MAJOR=1 to allow them."
    hc_fail "major bump refused"
    finish skipped 2
  fi
  [ -z "$MAJOR_NOTE" ] || log_warn "$MAJOR_NOTE"
fi

# From here on the cycle has something to deploy, and deploying means a
# canary. A host-networked sidecar can never run one: say so now, before
# preflight or any container is started for nothing. Not earlier: the
# up-to-date path above needs no canary and works in host mode, and the
# quarantine and major-version verdicts keep their exit code.
if ! canary_supported; then
  notify blocked "canary could not start" "Image $DECLARED with the declared configuration failed to start in the canary. Production untouched."
  hc_fail "canary start failed"
  finish blocked 1
fi

# EVERY image about to be canaried and recreated is verified — not only a new
# digest: the unchanged image of a configuration-only cycle is recreated too,
# and may be the baseline image this sidecar never checked.
verify_image_once "$DECLARED" resolver || refuse_unverified

# Downgrade guard, AFTER verification so that the labels it reads are the
# release pipeline's own. A signature proves who built an image, not that it
# is the newest: whoever can move the tag (a leaked registry token, a stale or
# hostile mirror) could otherwise roll every host back to an older, properly
# signed release with known vulnerabilities, and it would pass the canary.
if [ "$image_changed" = 1 ]; then
  new_v=$(image_version_label "$DECLARED")
  if version_downgrade "$RUNNING_VERSION" "$new_v" && [ "${ALLOW_DOWNGRADE:-0}" != 1 ]; then
    log_warn "downgrade $RUNNING_VERSION -> $new_v refused (set ALLOW_DOWNGRADE=1 to accept)"
    notify skipped "downgrade not deployed" "The declared image $DECLARED is Unbound $new_v, OLDER than the running $RUNNING_VERSION. A downgrade is a deliberate human decision; set ALLOW_DOWNGRADE=1 to allow it. Production untouched."
    hc_fail "downgrade refused"
    finish skipped 2
  fi
  [ -z "$DOWNGRADE_NOTE" ] || log_warn "$DOWNGRADE_NOTE"
fi

if ! preflight_checkconf "$DECLARED"; then
  notify blocked "configuration rejected in preflight" "The declared configuration is not valid for image $DECLARED. Production untouched. See the updater logs for unbound-checkconf's own message."
  hc_fail "preflight failed"
  finish blocked 1
fi

CANARY_ACTIVE=1
if ! canary_up "$DECLARED"; then
  notify blocked "canary could not start" "Image $DECLARED with the declared configuration failed to start in the canary. Production untouched."
  canary_logs >&2
  hc_fail "canary start failed"
  finish blocked 1
fi
if ! wait_resolver "$CANARY_IP" 90 || ! validate_resolver "$CANARY_IP"; then
  log_error "canary validation FAILED — production untouched"
  canary_logs >&2
  notify blocked "canary rejected the update" "Image $DECLARED with the declared configuration and a clone of production state failed DNS validation. Production untouched; the cycle will retry."
  hc_fail "canary validation failed"
  finish blocked 1
fi
log_info "canary validated: image, production state and configuration work together"
canary_down
CANARY_ACTIVE=0

if [ "$CHECK_ONLY" = 1 ]; then
  log_info "check mode: everything validated, no swap performed"
  hc_success
  finish check_ok 0
fi

# Compose keys recreation on the service's config hash, which the CONTENTS of
# a bind-mounted file do not affect. Without --force-recreate a config-only
# change would be a silent no-op that still reported success — the exact
# failure mode this project exists to remove.
recreate=()
[ "$image_changed" = 0 ] && recreate=(--force-recreate)

# Export the cache of the outgoing resolver, reloaded into the new one once
# it has passed its own validation (lib/cache.sh). Best effort: a failure
# here only means starting cold, as before.
if [ "$KEEP_CACHE" = 1 ]; then
  if cache_compatible "$RUNNING_VERSION" "$(image_version_label "$DEPLOY_ID")" "$image_changed"; then
    CACHE_DUMP=$(mktemp)
    cache_save "$PRE_SWAP_CONTAINER" "$CACHE_DUMP" || CACHE_DUMP=""
  else
    log_info "cache not preserved: the unbound version changes beyond a patch release"
  fi
fi

# ── Swap ────────────────────────────────────────────────────────────────────
# The ONE place the operator's tag moves: onto DEPLOY_ID, verified and
# canaried, and Compose is forbidden to pull (`--pull never` overrides
# `pull_policy: always`), so a tag moved in the registry since the canary
# cannot reach production. The operator's own compose files are used
# unchanged, which keeps their own `docker compose up -d` a no-op afterwards.
# The intent is persisted first: a cycle killed from here on is finished by
# the next one (recover_interrupted_swap above).
IN_SWAP=1
PRE_TAG_ID=$(image_id_of "$DECLARED_IMAGE_REF")
state_set SWAP_INTENT "$DECLARED $DEPLOY_ID $RUNNING_ID $CONF_HASH $image_changed $conf_changed $RUNNING_REPO $PRE_SWAP_CONTAINER ${PRE_TAG_ID:--}"
log_info "swapping $TARGET_SERVICE (brief restart)"
swap_ok=1
if tag_for_deploy "$DECLARED_IMAGE_REF" "$DEPLOY_ID"; then
  swap_out=$(compose up -d --no-deps --pull never "${recreate[@]}" "$TARGET_SERVICE" 2>&1) || swap_ok=0
else
  swap_ok=0; swap_out="cannot point $DECLARED_IMAGE_REF at the verified image"
fi
SWAPPED_CONTAINER=$(compose ps -q "$TARGET_SERVICE" 2>/dev/null || true)
if [ "$swap_ok" = 0 ]; then
  log_error "docker compose up failed while swapping to $DECLARED"
  printf '%s\n' "$swap_out" >&2
fi

if [ "$swap_ok" = 1 ] && post_swap_validated; then
  record_success_and_finish
fi
# The rollback replaces the failed container and its log with it: keep what
# it said, as for a failed canary.
if [ -n "$SWAPPED_CONTAINER" ] && [ "$SWAPPED_CONTAINER" != "$PRE_SWAP_CONTAINER" ]; then
  log_error "last lines logged by the container that failed the post-swap validation:"
  docker logs --tail 20 "$SWAPPED_CONTAINER" >&2 2>&1 || true
fi
rollback_and_finish 1
